{
  "name": "georescue-infrastructure",
  "private": true,
  "version": "1.0.0",
  "description": "GeoRescue serverless data pipeline (AWS SAM): USGS ingestion, S3 storage and HTTP API",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate": "sam validate --lint",
    "build": "sam build",
    "local": "esbuild scripts/local-server.ts --bundle --platform=node --format=esm --target=node20 --outfile=.local/server.mjs --log-level=warning && node .local/server.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1152.0",
    "esbuild": "0.28.2"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.164",
    "@types/node": "24.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.9"
  }
}
