# ─────────────────────────────────────────────────────────────
# GeoRescue frontend configuration
# Copy to .env.local and fill in values. Every variable is optional:
# with nothing set, the app reads USGS directly and uses an open basemap.
# Never put AWS access keys or secrets here — VITE_* values are public.
# ─────────────────────────────────────────────────────────────

# GeoRescue AWS API ───────────────────────────────────────────
# The `ApiUrl` output of the SAM stack in infrastructure/ (no trailing slash).
# When set, earthquakes load from API Gateway → Lambda → S3 instead of USGS directly,
# and WorldPop population exposure estimates are enabled (served by the same API).
VITE_API_BASE_URL=
# Fall back to the direct USGS feed if the AWS API fails (true | false)
VITE_API_FALLBACK_TO_USGS=true

# Amazon Location Service (Maps API v2) ───────────────────────
# Browser-safe API key. Allow only the action geo-maps:GetTile on
# arn:aws:geo-maps:<region>::provider/default and restrict referrers to your
# app's URLs (e.g. http://localhost:5173/*). The SAM stack can create this
# key for you (CreateMapApiKey=true) — see infrastructure/README.md.
VITE_AWS_REGION=us-east-1
VITE_AWS_LOCATION_API_KEY=
# Map style: Standard | Monochrome | Hybrid | Satellite
VITE_AWS_LOCATION_MAP_STYLE=Monochrome
# Color scheme for Standard / Monochrome styles: Dark | Light
VITE_AWS_LOCATION_COLOR_SCHEME=Dark
# Optional driving routes (Amazon Location Routes v2). The same API key must also
# allow geo-routes:CalculateRoutes on arn:aws:geo-routes:<region>::provider/default
# (SAM: EnableMapRouting=true). Leave false to show straight-line distances only.
VITE_AWS_LOCATION_ENABLE_ROUTING=false

# Optional: override the fallback basemap (any MapLibre style URL)
VITE_FALLBACK_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json

# Direct data sources ─────────────────────────────────────────
VITE_USGS_FEED_BASE_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary
# Comma-separated list of Overpass API endpoints, tried with failover
VITE_OVERPASS_ENDPOINTS=https://overpass-api.de/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter,https://overpass.private.coffee/api/interpreter
